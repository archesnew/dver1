@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ===================================================
echo   Запуск интернет-магазина «Двери №1»
echo ===================================================
echo Проект: %CD%
echo Порт: 3000
echo.
echo Открытие сайта в браузере...
start http://localhost:3000/
