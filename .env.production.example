# ==========================================================================
# ДВЕРИ №1 — PRODUCTION CONFIGURATION TEMPLATE
# Скопируйте этот файл в .env и заполните реальными ключами перед запуском в продакшене.
# ==========================================================================

# Серверный порт и окружение
PORT=3000
NODE_ENV=production

# --------------------------------------------------------------------------
# 1. SMS-ИНТЕГРАЦИЯ (SMS.RU)
# Получение ключа: https://sms.ru/ (Личный кабинет -> API-ключ)
# Если ключ не задан, SMS отправляться не будут, а в лог будет записано предупреждение.
# --------------------------------------------------------------------------
SMS_PROVIDER=smsru
SMS_API_KEY=your_sms_ru_api_key_here

# --------------------------------------------------------------------------
# 2. TELEGRAM-БОТ ДЛЯ УВЕДОМЛЕНИЙ О ЗАКАЗАХ
# Создание бота: @BotFather в Telegram -> /newbot -> скопировать HTTP API token
# ID чата: добавьте бота в чат/канал администраторов или напишите боту /start,
# затем получите ID через https://api.telegram.org/bot<TOKEN>/getUpdates
# --------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_channel_or_group_chat_id_here
