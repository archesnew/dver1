# ==============================================================================
# «Двери №1» — Конфигурация внешних сервисов (SMS и Telegram)
# Скопируйте этот файл в .env и укажите реальные ключи при запуске в production
# ==============================================================================

# Порт сервера (по умолчанию 3000)
PORT=3000

# 1. SMS-провайдер (SMS.RU или SMSAero)
# Если ключ не задан, сервер работает в безопасном режиме разработки:
# логирует отправку в data/sms/sms_dispatches.log без сбоев интерфейса
SMS_PROVIDER=smsru
SMS_API_KEY=

# 2. Уведомления менеджеров в Telegram
# При отсутствии токенов заявка сохраняется в data/orders/orders.json без сбоев
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
