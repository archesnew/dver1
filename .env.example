# ==============================================================================
# «ДВЕРИ №1» — Конфигурация окружения (Environment Variables)
# ==============================================================================

# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# Режим окружения: production | development
NODE_ENV=production

# SMS-провайдер (SMS.RU / SMSAERO)
# Если ключ не задан, сервер работает в безопасном режиме разработки,
# фиксируя коды подтверждения в data/sms/sms_dispatch.log
SMS_API_KEY=

# Telegram-уведомления для дежурных инженеров шоурумов
# Отправка спецификаций заказов в чат менеджеров в Казани и Набережных Челнах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
